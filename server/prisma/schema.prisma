datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum ContactStatus {
  LEAD
  PROSPECT
  CUSTOMER
  ARCHIVED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(USER)
  avatar        String?
  isActive      Boolean        @default(true)
  contacts      Contact[]
  imports       ImportBatch[]
  auditLogs     AuditLog[]
  googleSyncs   GoogleSync[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Contact {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String?
  email         String?
  phone         String?
  company       String?
  jobTitle      String?
  tags          String[]       @default([])
  status        ContactStatus  @default(LEAD)
  source        String         @default("MANUAL") // MANUAL, CSV_IMPORT, EXCEL_IMPORT, GOOGLE_SHEETS
  customFields  Json?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, email])
  @@index([userId, phone])
  @@map("contacts")
}

model ImportBatch {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String         // CSV, XLSX
  totalRows     Int
  importedRows  Int
  failedRows    Int
  duplicateRows Int
  status        String         // SUCCESS, PARTIAL, FAILED
  errorLog      Json?          // Array of { row, error, data }
  createdAt     DateTime       @default(now())

  @@map("import_batches")
}

model AuditLog {
  id            String         @id @default(uuid())
  userId        String?
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String         // LOGIN, CONTACT_CREATE, CONTACT_UPDATE, CONTACT_DELETE, CSV_IMPORT, EXPORT, GOOGLE_SYNC
  entityType    String         // CONTACT, USER, IMPORT, SYSTEM
  entityId      String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime       @default(now())

  @@map("audit_logs")
}

model GoogleSync {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  spreadsheetId String
  sheetName     String         @default("Sheet1")
  syncDirection String         @default("IMPORT") // IMPORT, EXPORT, TWO_WAY
  lastSyncAt    DateTime?
  autoSync      Boolean        @default(false)
  createdAt     DateTime       @default(now())

  @@map("google_syncs")
}
